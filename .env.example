# Copy to .env and adjust. Every setting has a working default for local SQLite + Ollama.

# Database the agent reads (opened read-only). SQLite or PostgreSQL.
QUERYA_DATABASE_URL=sqlite:///data/retail.db
# QUERYA_DATABASE_URL=postgresql+psycopg://querya_ro:<password>@localhost:5433/retail
QUERYA_TRACE_DATABASE_URL=sqlite:///data/traces.db

# LLM provider: "openai" (any OpenAI-compatible server, including Ollama) or "anthropic"
QUERYA_LLM_PROVIDER=openai
QUERYA_LLM_MODEL=qwen2.5-coder:3b
QUERYA_OPENAI_BASE_URL=http://localhost:11434/v1
QUERYA_OPENAI_API_KEY=ollama
# ANTHROPIC_API_KEY=<your-key>

# Guardrails
QUERYA_MAX_ROWS=200
QUERYA_STATEMENT_TIMEOUT_MS=5000
QUERYA_MAX_SQL_RETRIES=3
QUERYA_MAX_STEPS=12

# Optional Langfuse export (needs `uv sync --extra langfuse`)
QUERYA_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=<pk>
# LANGFUSE_SECRET_KEY=<sk>
# LANGFUSE_HOST=https://cloud.langfuse.com

# docker compose only
POSTGRES_PASSWORD=<admin-password>
QUERYA_RO_PASSWORD=<read-only-password>
